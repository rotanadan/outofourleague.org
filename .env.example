# Supabase — from your project's API settings (or `npx supabase start` locally)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-publishable-anon-key
# Server-only. Bypasses row level security — never expose this to the browser.
NUXT_SUPABASE_SECRET_KEY=your-secret-key

# Where the app is reachable; used for Stripe redirect URLs and auth callbacks
NUXT_PUBLIC_SITE_URL=http://localhost:3000

# Stripe (weekly dues) — leave blank until you wire up payments
NUXT_STRIPE_SECRET_KEY=
NUXT_STRIPE_WEBHOOK_SECRET=
NUXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
